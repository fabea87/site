{
  // Cloudflare Worker with static assets only (no Worker script):
  // `wrangler deploy` uploads everything in dist/ as the site.
  // GitHub holds the code only; hosting is entirely on Cloudflare.
  //
  //   npm run build                   # build dist/ with Vite
  //   npm run dev                     # local Vite dev server
  //   npm run deploy                  # build and deploy to Cloudflare Worker
  //   npx wrangler dev                # local preview
  "name": "site",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist"
  }
}
